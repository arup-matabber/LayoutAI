# MongoDB Atlas (managed, free tier) - Compass/Atlas UI gives you this string
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/autolayout

# JWT signing secret - any long random string
JWT_SECRET=change-me

# Cloudflare R2 (S3-compatible object storage, free 10GB tier)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=autolayout
# Public bucket URL (Settings -> Public Access -> enable the r2.dev subdomain,
# or a custom domain). NOT the private accountid.r2.cloudflarestorage.com
# S3 API endpoint - that one requires signed requests and won't serve images.
R2_PUBLIC_BASE_URL=

# Gemini API - Enhance step reads handwritten annotations + infers styling intent
GEMINI_API_KEY=

# OpenRouter - fallback for the above when Gemini errors or is unset
# (Claude 3 Haiku for the vision call, text-embedding-3-small for embeddings).
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Actian Vector AI DB - Enhance step's RAG pattern-library lookup.
# Runs as the `actian` service in docker-compose.yml alongside `api` - use
# the compose service name here, not localhost (api and actian are separate
# containers; "localhost" from inside api only ever resolves to api itself).
# ACTIAN_CONNECTION_STRING is a host:port for the gRPC server (default port
# 6574), not a URL. Auth isn't required for local dev, so ACTIAN_API_KEY can
# stay blank unless you've enabled auth on the instance.
ACTIAN_CONNECTION_STRING=actian:6574
ACTIAN_API_KEY=

PORT=3000
